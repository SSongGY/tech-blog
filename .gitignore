# 플랫폼 발행용 변환본 — 언제든 scripts/blog.py tistory 로 다시 생성된다
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 예제 실행 중 생기는 산출물
*.db
*.sqlite3
*.log

# 이 PC 환경에 묶인 설정 — 저장소가 아니라 머신에 속한다.
# 자동 실행 루틴이 git add -A 를 쓰므로 여기서 막지 않으면 딸려 올라간다.
.claude/settings.json
.claude/settings.local.json
.claude/settings.help.json

# 편집기 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 도식 확인용 임시 파일 — 저장소에 남기지 않는다.
# 루틴이 git add -A 를 쓰므로 막지 않으면 공개 저장소에 올라간다.
figcheck.html
*.figcheck.html

# 동작 확인용 임시 파일 — code/ 안에서 돌리되 저장소에는 남기지 않는다.
# 루틴이 git add -A 를 쓰므로 여기서 막아 두면 지울 일이 없다.
# 확인이 끝나 예제로 쓸 것은 제 이름을 붙인다 (probe 로 시작하면 버리는 것이다).
posts/**/code/probe*
posts/**/code/_scratch*

# 회차가 저장소 루트에 probe 폴더를 만드는 경우가 있다 (du·find 글의 실습 고정물).
# 위 규칙은 code/ 아래만 막으므로 루트에 72MB 가 추적되지 않은 채 남아 있었다.
probe*
_scratch*

# 권한 설정 백업 — settings.json 자체는 위에서 막았지만 .bak 은 안 막혔다.
# 머신에 묶인 설정이 통째로 들어 있으므로 공개 저장소에 올라가면 안 된다.
.claude/*.bak-*
.claude/*.bak

# 예제가 만드는 작업 폴더. 스크립트가 다시 만들므로 저장소에 둘 이유가 없다.
# (현재 규약은 probe_work/ 지만, 이름을 바꾸기 전 회차가 남긴 work/ 가 있다.)
posts/**/code/work/
